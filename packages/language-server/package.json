{
  "name": "stylus-lsp",
  "version": "0.6.1",
  "description": "Tree-sitter language server for Stylus and embedded component style blocks",
  "author": "WMikhail",
  "type": "module",
  "bin": {
    "stylus-language-server": "dist/server.js"
  },
  "files": [
    "dist",
    "assets",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "benchmark": "node benchmarks/workspace-benchmark.mjs",
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && tsc -p tsconfig.json --noEmit",
    "format": "prettier --write src tests benchmarks package.json",
    "format:check": "prettier --check src tests benchmarks package.json",
    "lint": "eslint src tests benchmarks",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test",
    "test:e2e": "node --test tests/server.test.mjs",
    "test:golden": "node --test tests/golden.test.mjs",
    "test:integration": "node --test tests/analyzer.test.mjs tests/authoring.test.mjs tests/configuration.test.mjs tests/diagnostics.test.mjs tests/fixture-projects.test.mjs tests/navigation.test.mjs",
    "test:unit": "node --test tests/background-tasks.test.mjs tests/cache-invalidation.test.mjs tests/embedded-documents.test.mjs tests/glob-utils.test.mjs tests/import-resolver.test.mjs tests/parser-compatibility.test.mjs tests/protocol.test.mjs tests/semantic-model.test.mjs tests/workspace-scanner.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "stylus",
    "language-server",
    "lsp",
    "vue",
    "svelte",
    "astro"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WMikhail/stylus-tooling.git",
    "directory": "packages/language-server"
  },
  "homepage": "https://github.com/WMikhail/stylus-tooling/tree/main/packages/language-server#readme",
  "bugs": {
    "url": "https://github.com/WMikhail/stylus-tooling/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@astrojs/compiler": "^4.0.0",
    "@vue/compiler-sfc": "^3.5.40",
    "color-name": "^2.1.0",
    "ignore": "^7.0.6",
    "minimatch": "^10.2.6",
    "typescript": "^5.9.3",
    "vscode-css-languageservice": "^6.3.10",
    "vscode-languageserver": "^10.1.0",
    "vscode-languageserver-textdocument": "^1.0.12",
    "web-tree-sitter": "^0.25.10"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}

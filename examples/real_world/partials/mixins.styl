focus-ring(color = $primary)
  outline 2px solid rgba(color, .35)
  outline-offset 2px

elevation(level = 1)
  if level == 1
    box-shadow 0 1px 2px rgba(#172033, .08)
  else if level == 2
    box-shadow 0 8px 24px rgba(#172033, .12)
  else
    box-shadow none

button-tone(background, foreground = #fff)
  background background
  border-color background
  color foreground

visually-hidden()
  position absolute
  width 1px
  height 1px
  padding 0
  margin -1px
  overflow hidden
  clip rect(0, 0, 0, 0)
  white-space nowrap
  border 0
